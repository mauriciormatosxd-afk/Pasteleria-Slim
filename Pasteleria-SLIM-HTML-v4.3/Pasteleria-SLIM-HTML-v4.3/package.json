{
  "name": "pasteleria-slim-html",
  "private": true,
  "scripts": {
    "less": "lessc --source-map less/styles.less css/styles.css",
    "less:min": "lessc less/styles.less | cleancss -o css/styles.min.css",
    "watch": "nodemon -e less -x \"npm run less\"",
    "sass": "sass --style=compressed scss/main.scss css/styles-sass.css",
    "format": "prettier --write js/main.js",
    "build": "npm run less && npm run less:min && npm run sass"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "less": "^4.9.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2"
  }
}
